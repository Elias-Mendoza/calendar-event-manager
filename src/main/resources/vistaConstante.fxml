<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="rootVistaPrincipal" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ControladorPrincipal">
   <children>
      <VBox styleClass="barra-lateral" prefHeight="720.0" prefWidth="150.0">
         <children>
            <Label styleClass="titulo-app" text="Calendario" />
            <Label styleClass="subtitulo-app" text="Eventos y tareas" />
            <Label styleClass="seccion" text="VISTAS" />
            <Button fx:id="botonVistaPorDia" styleClass="boton-nav" maxWidth="Infinity" mnemonicParsing="false" text="Día" />
            <Button fx:id="botonVistaPorSemana" styleClass="boton-nav" maxWidth="Infinity" mnemonicParsing="false" text="Semana" />
            <Button fx:id="botonVistaPorMes" styleClass="boton-nav" maxWidth="Infinity" mnemonicParsing="false" text="Mes" />
            <Region VBox.vgrow="ALWAYS" />
            <Label styleClass="seccion" text="NUEVO" />
            <Button fx:id="botonAgregarEvento" styleClass="boton-accion" maxWidth="Infinity" mnemonicParsing="false" text="+ Evento" />
            <Button fx:id="botonAgregarTarea" mnemonicParsing="false" maxWidth="Infinity" text="+ Tarea">
               <styleClass>
                  <String fx:value="boton-accion" />
                  <String fx:value="secundario" />
               </styleClass>
            </Button>
         </children>
      </VBox>
      <StackPane fx:id="contenedorVistas" layoutX="150.0" prefHeight="720.0" prefWidth="1130.0" />
   </children>
</Pane>
